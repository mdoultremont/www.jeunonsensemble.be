{
  "name": "jeunonsensemble.be",
  "private": true,
  "description": "Site web de Jeûnons Ensemble",
  "author": "Matthieu d'Oultremont <matthieu.doultremont@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm run check && vite build",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "CONTENT_SOURCE=contentful pnpm run build && pnpm run verify && wrangler deploy",
    "deploy:preview": "CONTENT_SOURCE=contentful pnpm run build && pnpm run verify && wrangler preview",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "build:fixture": "CONTENT_SOURCE=fixture vite build",
    "preview:fixture": "pnpm run build:fixture && pnpm run serve:fixture",
    "serve:fixture": "wrangler dev --config wrangler.fixture.jsonc --port 4173",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:browser": "playwright test",
    "verify": "tsx scripts/verify-output.ts dist/client contentful",
    "verify:fixture": "tsx scripts/verify-output.ts dist-fixture/client fixture"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@fontsource-variable/rubik": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/start-static-server-functions": "^1.167.44",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@10.28.2"
}
